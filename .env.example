# Real, live indoor-volleyball match data.
#
# Live Results and Match Schedules are fetched EXCLUSIVELY and DIRECTLY from
# the browser, straight to the Highlightly Volleyball API, using the key
# below — no server-side proxy and no third-party CORS relay of any kind
# sits in front of it. Set ONE of the two options below (Option 1 takes
# priority if both are set). See the "Live volleyball data" section of
# README.md.

# Option 1 — direct signup at https://highlightly.net (takes priority if set)
VITE_HIGHLIGHTLY_API_KEY=

# Option 2 — via the RapidAPI marketplace instead
VITE_RAPIDAPI_KEY=

# Optional overrides — only needed for a custom/self-hosted mirror
VITE_HIGHLIGHTLY_BASE_URL=
VITE_HIGHLIGHTLY_API_HOST=

# Supabase Auth (admin login + password changes, synced across devices).
# Create a free project at https://supabase.com, then paste its URL and
# anon/public key below. Without these set, the admin dashboard falls
# back to the existing local/localStorage credential check automatically.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# Security options (all optional)
# ---------------------------------------------------------------------
# Anti-clone domain lock: comma-separated list of the domains that may run
# this build (wildcards like *.example.com allowed). Any other domain shows
# an "Unauthorized copy" screen. localhost / LAN hosts are always allowed.
# Leave EMPTY until you know your final domain.
VITE_ALLOWED_HOSTS=

# Automated browsers (Selenium / Puppeteer / Playwright / headless Chrome)
# get no content by default. Set to "false" to disable — e.g. when running
# your own Playwright or Lighthouse checks against the production build.
VITE_BLOCK_AUTOMATION=

# NOTE: every VITE_* value is compiled into the public JavaScript bundle and
# is readable by any visitor. That is fine for the Supabase URL and the
# publishable/anon key (protected by Row Level Security). VITE_HIGHLIGHTLY_API_KEY
# and VITE_RAPIDAPI_KEY are real secrets and, by design in this build, are
# called directly from the browser with no server-side proxy in front of
# them — so they are just as visible to any visitor. What protects the
# key's daily quota here is the aggressive localStorage cache in
# src/services/volleyballApi.js (CACHE_TTL_MS, a few hours), the shared
# Supabase cache, and the 429/403 circuit breaker — not secrecy of the key
# itself. Set a spend/rate limit and an allowed-domain restriction in that
# provider's dashboard, and rotate the key if you ever suspect abuse.
